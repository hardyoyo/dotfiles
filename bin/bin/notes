#!/usr/bin/env bash
set -euo pipefail

pattern='TODO|FIXME'
files=("$@")

print_heading() {
  printf "\n=== %s ===\n" "$1"
}

extract_quick_reference() {
  awk '
    /^## Project Quick Reference/ {
      in_section=1
      next
    }

    /^## / && in_section {
      exit
    }

    in_section {
      print
    }
  ' CLAUDE.md
}

extract_readme_intro() {
  awk '
    /^## / {
      exit
    }

    {
      print
    }
  ' "$1"
}

print_project_orientation() {
  local content

  if [ -f CLAUDE.md ]; then
    content="$(extract_quick_reference)"

    if [ -n "$content" ]; then
      print_heading "Project Orientation"
      printf "%s\n" "$content" | sed -n '1,40p'
      return 0
    fi
  fi

  for f in README.md README README.txt; do
    if [ -f "$f" ]; then
      print_heading "Project Orientation"
      extract_readme_intro "$f" | sed -n '1,40p'
      return 0
    fi
  done

  return 1
}

search_files() {
  local rg_args=(
    --line-number
    --with-filename
    --ignore-case
    --color=never
    --max-filesize=1M

    -g '!*.mp4'
    -g '!*.mov'
    -g '!*.avi'
    -g '!*.mkv'
    -g '!*.webm'

    -g '!*.gif'
    -g '!*.png'
    -g '!*.jpg'
    -g '!*.jpeg'
    -g '!*.webp'
    -g '!*.svg'

    -g '!*.pdf'

    -g '!*.zip'
    -g '!*.tar'
    -g '!*.gz'
    -g '!*.tgz'

    -g '!*.mp3'
    -g '!*.wav'
    -g '!*.flac'

    -tpy
    -tjs
    -tsh
    -tts
    -tgo
    -truby
    -tjava
  )

  local rg_pid

  printf "Scanning source files for TODO/FIXME comments" >&2

  if [ "${#files[@]}" -gt 0 ]; then
    rg "${rg_args[@]}" "$pattern" "${files[@]}" &
  else
    rg "${rg_args[@]}" "$pattern" . &
  fi

  rg_pid=$!

  while kill -0 "$rg_pid" 2>/dev/null; do
    printf "." >&2
    sleep 1
  done

  printf "\n" >&2

  wait "$rg_pid"
}

print_project_files() {
  local printed=0

  for f in NOTES TODO TODO.md; do
    if [ -f "$f" ]; then
      if (( ! printed )); then
        print_heading "Project Files"
        printed=1
      fi

      printf "\n--- %s ---\n" "$f"
      cat "$f"
    fi
  done

  if (( ! printed )); then
    return 1
  fi
}

print_missing_summary() {
  local first=1

  printf "\n("

  for msg in "$@"; do
    if (( first )); then
      printf "%s" "$msg"
      first=0
    else
      printf ", %s" "$msg"
    fi
  done

  printf ")\n"
}

# ---- main ----

start_time=$SECONDS

missing=()

# TODO/FIXME section first for faster visible feedback
print_heading "TODO/FIXME Comments"

if ! search_files; then
  missing+=("no TODO/FIXME comments found")
fi

# Project orientation (optional)
print_project_orientation || true

# Project files section
if ! print_project_files; then
  missing+=("no Project Files found")
fi

# Missing summary
if [ "${#missing[@]}" -gt 0 ]; then
  print_missing_summary "${missing[@]}"
fi

printf "\nCompleted in %ss\n" "$((SECONDS - start_time))"

exit 0
