#!/usr/bin/env python3

import click
import subprocess

@click.command()
@click.option('--message', '-m', help='Alert message')
def send_notification(message):
    """
    Send an alert with customizable message.
    """
    notification_cmd = ['osascript', '-e', f'display alert "{message}"']

    subprocess.run(notification_cmd)

if __name__ == '__main__':
    send_notification()

