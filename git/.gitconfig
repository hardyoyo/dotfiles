[user]
	email = hardy.pottinger@ucsf.edu
	name = Hardy Pottinger
[pull]
    rebase = true
[core]
    autocrlf = input
	excludesFile = ~/.gitignore_global
	abbrev = 9
	editor = vim
	trustctime = false
	quotepath = off
	pager = bat
[alias]
	a = add
	b = branch
	c = commit --verbose
	co = checkout
	d = diff
	dn = diff --name-only
	ds = diff --staged
	du = count-objects --verbose --human-readable
	f = fetch
	h = help
	hc = help config
	l = log
	lol = log --graph --pretty=oneline
 	lolz = log --pretty=format:'%C(yellow)%h%Cblue%d%Creset %s %C(white) %an, %ar%Creset' --graph
	m = merge
	n = !git ls-files | xargs notes
	nuke = !git clean -fdx && git submodule foreach git clean -fdx
	p = pull
	ps = push
	pr = pull-request
	r = reset
	rb = rebase
	redo = commit --amend --no-edit
	s = status --short --branch
	sh = show
	st = stash
	stat = status
	sub = submodule
	y = cherry-pick
    cleanup = "!git branch --merged | grep  -v '\\*\\|master\\|develop' | xargs -n 1 git branch -d"
	aliases = config --get-regexp ^alias\\.
[am]
	threeWay = true
[apply]
	ignoreWhitespace = change
[color]
	ui = auto
[diff]
	tool = meld
	mnemonicPrefix = true
	# external = difft --background light
[format]
	pretty = medium
[help]
	autoCorrect = -1
[log]
	abbrevCommit = true
	decorate = short
[merge]
	keepbackups = false
	tool = kdiff3
[credential]
	credentialStore = keychain
	helper = git-credential-manager
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[difftool]
    prompt = false
[difftool "meld"]
    cmd = meld "$LOCAL" "$REMOTE"
[mergetool "meld"]
    cmd = meld "$LOCAL" "$MERGED" "$REMOTE" --output "$MERGED"
	trustExitCode = true
    keepBackup = false
[mergetool "diffconflicts"]
	cmd = vim -c DiffConflicts "$MERGED" "$BASE" "$LOCAL" "$REMOTE"
	trustExitCode = true
	keepBackup = false
[http]
	sslVerify = true
[push]
	default = current
	autoSetupRemote = true
[rebase]
	stat = true
	autoSquash = true
	autoStash = true
[rerere]
	enabled = true
	autoUpdate = true
[include]
	path = ~/.gitconfig_local
[init]
	templatedir = ~/.git_template
	defaultBranch = main
[mergetool]
	trustExitCode = true
[gui]
	encoding = utf-8
[commit]
	gpgsign = true
[mergetool "kdiff3"]
	path = /Applications/kdiff3.app/Contents/MacOS/kdiff3
[pager]
	diff = riff --no-pager
	show = riff --no-pager
	log = riff --no-pager
[interactive]
	diffFilter = riff --no-pager
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://git.ucsf.edu"]
	provider = github
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://git-stage.ucsf.edu"]
	provider = github
[credential "https://dev.azure.com"]
	useHttpPath = true
